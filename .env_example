# Copie este arquivo para .env e ajuste apenas o que precisar.
# Nunca publique o arquivo .env: ele pode conter chaves privadas.

# Nome mostrado na janela e nas mensagens do assistente.
AI_NAME=Minha IA Local

# Onde conversas, índice dos documentos e anexos serão salvos.
# Use um caminho seu; deixe vazio para usar %APPDATA%\LocalAI.
# AI_DATA_DIR=C:\Users\seu-usuario\AppData\Roaming\MinhaIA

# Endereço do Ollama local.
OLLAMA_URL=http://localhost:11434

# Opcional: ativa os modelos Gemini configurados no app.
# GEMINI_API_KEY=cole_sua_chave_aqui
